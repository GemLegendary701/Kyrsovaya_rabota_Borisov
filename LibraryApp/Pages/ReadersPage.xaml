<Page x:Class="LibraryApp.Pages.ReadersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Читатели" Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Список читателей" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>
            <Button x:Name="btnAddReader" Content="Добавить читателя" Width="150" Height="35" Click="btnAddReader_Click" 
                    Background="Green" Foreground="White" BorderThickness="0"/>
            <Button Content="К списку книг" Width="120" Height="35" Click="btnGoToBooks_Click" Margin="10,0,0,0"/>
        </StackPanel>

        <ListBox x:Name="lvReaders" Grid.Row="1" BorderBrush="Gray" BorderThickness="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="10" Margin="0,5">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Orientation="Vertical" Width="300">
                                <TextBlock Text="ФИО:" FontWeight="Bold" Foreground="Gray"/>
                                <TextBlock Text="{Binding FullName}" FontSize="16"/>
                            </StackPanel>
                            <StackPanel Orientation="Vertical" Width="150">
                                <TextBlock Text="Номер билета:" FontWeight="Bold" Foreground="Gray"/>
                                <TextBlock Text="{Binding TicketNumber}" FontSize="16"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>