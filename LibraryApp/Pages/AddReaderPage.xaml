<Page x:Class="LibraryApp.Pages.AddReaderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Добавление читателя" Background="#F3F4F6">
    <Grid MaxWidth="450" VerticalAlignment="Top" Margin="0,40,0,0" HorizontalAlignment="Center">
        <Border Background="White" CornerRadius="10" Padding="30">
            <StackPanel>
                <TextBlock Text="Новый читатель" FontSize="22" FontWeight="Bold" Margin="0,0,0,25" HorizontalAlignment="Center"/>

                <TextBlock Text="ФИО:" Margin="0,0,0,5"/>
                <TextBox x:Name="txtFullName" Height="35" Margin="0,0,0,15" VerticalContentAlignment="Center"/>

                <TextBlock Text="Номер билета:" Margin="0,0,0,5"/>
                <TextBox x:Name="txtTicket" Height="35" Margin="0,0,0,30" VerticalContentAlignment="Center"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Сохранить" Width="110" Height="40" Margin="0,0,15,0" Click="btnSave_Click" Background="Green" Foreground="White" BorderThickness="0"/>
                    <Button Content="Отмена" Width="110" Height="40" Click="btnCancel_Click" Background="LightGray" BorderThickness="0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>