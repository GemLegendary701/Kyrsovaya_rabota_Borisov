<Page x:Class="LibraryApp.Pages.LoansPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Выдачи" Background="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Выдачи книг" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>
            <Button Content="К книгам" Width="100" Height="35" Click="btnGoToBooks_Click" Margin="10,0,0,0"/>
            <Button Content="Обновить" Width="100" Height="35" Click="btnLoadLoans_Click" Margin="10,0,0,0"/>
        </StackPanel>

        <ListBox x:Name="lvLoans" Grid.Row="1" BorderBrush="Gray" BorderThickness="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="10" Margin="0,5">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="White"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                        <Setter Property="Background" Value="#FEE2E2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Orientation="Vertical" Width="80">
                                <TextBlock Text="ID выдачи:" FontWeight="Bold" Foreground="Gray"/>
                                <TextBlock Text="{Binding Id}" FontSize="16"/>
                            </StackPanel>
                            <StackPanel Orientation="Vertical" Width="150">
                                <TextBlock Text="Книга (ID):" FontWeight="Bold" Foreground="Gray"/>
                                <TextBlock Text="{Binding BookId}" FontSize="16"/>
                            </StackPanel>
                            <StackPanel Orientation="Vertical" Width="150">
                                <TextBlock Text="Читатель (ID):" FontWeight="Bold" Foreground="Gray"/>
                                <TextBlock Text="{Binding ReaderId}" FontSize="16"/>
                            </StackPanel>
                            <StackPanel Orientation="Vertical" Width="120">
                                <TextBlock Text="Дата выдачи:" FontWeight="Bold" Foreground="Gray"/>
                                <TextBlock Text="{Binding IssueDate}" FontSize="16"/>
                            </StackPanel>
                            <StackPanel Orientation="Vertical" Width="120">
                                <TextBlock Text="Срок возврата:" FontWeight="Bold" Foreground="Gray"/>
                                <TextBlock Text="{Binding DueDate}" FontSize="16"/>
                            </StackPanel>
                            <StackPanel Orientation="Vertical" Width="120">
                                <TextBlock Text="Дата возврата:" FontWeight="Bold" Foreground="Gray"/>
                                <TextBlock Text="{Binding ReturnDate}" FontSize="16"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Вернуть выбранную книгу" Width="200" Height="40" Click="btnReturnBook_Click" 
                    Background="Orange" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Page>