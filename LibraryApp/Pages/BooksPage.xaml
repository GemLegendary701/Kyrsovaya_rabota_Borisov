<Page x:Class="LibraryApp.Pages.BooksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Книги"
      Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Список книг" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>
            <Button x:Name="btnLoadBooks" Content="Обновить" Width="100" Height="35" Margin="0,0,10,0" Click="btnLoadBooks_Click"/>
            <Button x:Name="btnAddBook" Content="Добавить книгу" Width="120" Height="35" Click="btnAddBook_Click"/>
            <Button x:Name="btnIssueBook" Content="Выдать книгу" Width="120" Height="35" Click="btnIssueBook_Click" Margin="10,0,0,0"/>
            <Button Content="Читатели" Width="100" Height="35" Click="btnGoToReaders_Click" Margin="10,0,0,0"/>
            <Button Content="Выдачи" Width="100" Height="35" Click="btnGoToLoans_Click" Margin="10,0,0,0"/>
        </StackPanel>

        <ListBox x:Name="lvBooks" Grid.Row="1" BorderBrush="Gray" BorderThickness="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="10" Margin="0,5">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Orientation="Vertical" Width="250">
                                <TextBlock Text="Название:" FontWeight="Bold" Foreground="Gray"/>
                                <TextBlock Text="{Binding Title}" FontSize="16"/>
                            </StackPanel>
                            <StackPanel Orientation="Vertical" Width="100">
                                <TextBlock Text="Год:" FontWeight="Bold" Foreground="Gray"/>
                                <TextBlock Text="{Binding Year}" FontSize="16"/>
                            </StackPanel>
                            <StackPanel Orientation="Vertical" Width="100">
                                <TextBlock Text="Кол-во:" FontWeight="Bold" Foreground="Gray"/>
                                <TextBlock Text="{Binding Quantity}" FontSize="16"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>